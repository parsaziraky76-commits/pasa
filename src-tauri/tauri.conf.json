{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dopamine",
  "version": "1.4.0",
  "identifier": "com.dopamine.desktop",
  "build": {
    "beforeBuildCommand": "npm run web:build",
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist-web"
  },
  "app": {
    "windows": [
      {
        "title": "Dopamine",
        "label": "main",
        "width": 390,
        "height": 820,
        "minWidth": 360,
        "minHeight": 720,
        "maximizable": false,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": false,
        "theme": "Dark",
        "backgroundColor": "#03040A",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist-engine/aether.exe": "engine/aether.exe",
      "../dist-engine/wintun.dll": "engine/wintun.dll",
      "../dist-engine/psiphon-tunnel-core.exe": "engine/psiphon-tunnel-core.exe",
      "../dist-engine/server_entries.txt": "engine/server_entries.txt",
      "../CORE_VERSION": "engine/CORE_VERSION"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": false
    },
    "publisher": "Dopamine",
    "copyright": "Includes third-party components; see bundled license notices.",
    "category": "Utility",
    "shortDescription": "Freedom, in one tap",
    "longDescription": "Dopamine Desktop — a Windows tunnelling client."
  },
  "plugins": {
    "shell": {
      "open": "^https://(t\\.me|aistudio\\.google\\.com|github\\.com)/"
    }
  }
}
